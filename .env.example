# Copy to .env and fill in. Never commit .env. Production values live in a secrets manager.

# --- API ---
API_PORT=4000
API_DOCS_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# Comma-separated browser origins allowed to call the API directly (web apps proxy, so usually empty)
CORS_ORIGINS=

# --- Web apps (server-side only) ---
API_INTERNAL_URL=http://127.0.0.1:4000
ALLOWED_DEV_ORIGINS=

# --- PostgreSQL (generate strong values; none are provided on purpose) ---
POSTGRES_DB=ninejavote
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis ---
REDIS_PASSWORD=
REDIS_URL=

# --- Auth (Day 2) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Providers (owner to supply) ---
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# --- Hard safety switches. Real-election features have no code path yet; these stay false. ---
REAL_VOTING_ENABLED=false
INEC_RESULTS_INTEGRATION_ENABLED=false
