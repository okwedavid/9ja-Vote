# Copy to .env.production, fill in, and never commit it.
# docker compose --env-file .env.production -f infrastructure/docker/docker-compose.prod.yml up -d --build

# --- domains (DNS A/AAAA records must already point at the server) ---
PUBLIC_DOMAIN=www.example.ng
ADMIN_DOMAIN=admin.example.ng
BROADCAST_DOMAIN=live.example.ng

# --- database ---
POSTGRES_DB=ninejavote
POSTGRES_USER=ninejavote
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- secrets: openssl rand -hex 32 ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- release metadata ---
GIT_SHA=

# --- optional providers (leave blank until contracts exist) ---
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# Demo safety switches: both must stay false. The schema enforces it too.
REAL_VOTING_ENABLED=false
INEC_RESULTS_INTEGRATION_ENABLED=false
