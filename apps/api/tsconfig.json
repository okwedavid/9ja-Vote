{
  "compilerOptions": {
    "module": "commonjs", "target": "ES2022", "moduleResolution": "node",
    "declaration": false, "removeComments": true, "emitDecoratorMetadata": true, "experimentalDecorators": true,
    "esModuleInterop": true, "sourceMap": true, "outDir": "./dist", "rootDir": "./src",
    "strict": true, "skipLibCheck": true, "incremental": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.spec.ts"]
}
